PORT=4242
APP_BASE_URL=http://localhost:4242
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MONTHLY_PRICE_ID=price_replace_monthly
STRIPE_LIFETIME_PRICE_ID=price_replace_lifetime
STRIPE_AUTOMATIC_TAX=false
STRIPE_TRIAL_DAYS=0
# Days a past_due (failed-renewal) subscription keeps Pro while Stripe retries.
STRIPE_GRACE_DAYS=14
# Point this at a PERSISTENT disk in production. On Render/Fly/Railway the
# default filesystem is wiped on every deploy, which would drop all Pro users.
ENTITLEMENT_STORE_PATH=./data/entitlements.json
